__pycache__/
*.pyc
.pytest_cache/

# Real FastText models are ~2.6 GB / ~2.8 GB and are downloaded on demand
# by data/scripts/download_fasttext.py, which records dimensions, vocab
# size and sha256 in data/fasttext_manifest.json.
*.bin

# Run artifacts. The repository holds code, configuration and the datasets
# the paper names -- never the output of a run. A committed checkpoint or
# results file would also make the tree look like it carries results that
# no longer correspond to the current code.
results/
results_b/
checkpoints/
outputs/
logs/
wandb/

# Model weights and serialized tensors, including the alignment matrix W.
# W is an author-supplied artifact (DEVIATIONS.md 1a): it is referenced by
# path from the config and must not be committed, or the repository would
# be shipping an alignment matrix the authors never specified.
*.pt
*.pth
*.npy
*.npz
*.ckpt
*.safetensors
*.h5
results_gen2_snapshot_20260924/

# Three directories hold runs the reported table draws on. Their per-run
# records are tracked so every published number can be checked against its
# own provenance; the model checkpoints beside them are tens of GB and stay
# out. The pattern admits only */experiment.json from each.
#
#   results_hornmorpho_wam/  Amharic XLM-R, FOCUS, LGSE (W_am, 235-item TC)
#   results_hornmorpho/      Amharic +LAPT and +Random+LAPT. Its config names
#                            W_ti, but neither system loads W -- W is read
#                            only on the FastText path (lap_trainer.py:78),
#                            and all ten NER runs are bit-identical to the
#                            W_am snapshot. Its LGSE and FOCUS runs are NOT
#                            usable; see IMPLEMENTATION_NOTES.md 5d-v.
#   results_tigrinya_gen2/   all five Tigrinya systems (W_ti, 151-item QA)
results_hornmorpho/*
!results_hornmorpho/*/
results_hornmorpho/*/*
!results_hornmorpho/*/experiment.json

results_tigrinya_gen2/*
!results_tigrinya_gen2/*/
results_tigrinya_gen2/*/*
!results_tigrinya_gen2/*/experiment.json
# Corrected-alignment-matrix rerun. The run records are tracked so the
# published numbers can be checked against their own provenance (commit,
# config sha256, W_am.npy, corpus checksum, per-seed metrics); the model
# checkpoints they sit beside are 27 GB and stay out.
results_hornmorpho_wam/*
!results_hornmorpho_wam/*/
results_hornmorpho_wam/*/*
!results_hornmorpho_wam/*/experiment.json
data/_incoming/
.claude/
